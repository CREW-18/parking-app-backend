PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/parkpulse
MONGO_DB=parkpulse
JWT_SECRET=replace-with-a-long-random-secret
# Optional local DNS fix for MongoDB Atlas SRV lookup issues on some networks.
# DNS_SERVERS=8.8.8.8,1.1.1.1
# Optional comma-separated origins, for example:
# CORS_ORIGIN=http://localhost:19006,http://localhost:8081
